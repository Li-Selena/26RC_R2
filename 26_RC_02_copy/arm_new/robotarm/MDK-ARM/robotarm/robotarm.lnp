"robotarm\stm32h7xx_hal_tim_ex.o"
"robotarm\system_stm32h7xx.o"
--strict --scatter "robotarm\robotarm.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "robotarm.map" -o robotarm\robotarm.axf