--cpu Cortex-M7.fp.dp
"robotarm\startup_stm32h723xx.o"
"robotarm\main.o"
"robotarm\gpio.o"
"robotarm\fdcan.o"
"robotarm\tim.o"
"robotarm\stm32h7xx_it.o"
"robotarm\stm32h7xx_hal_msp.o"
"robotarm\can_bsp.o"
"robotarm\dm_motor.o"
"robotarm\robstride01.o"
"robotarm\robotarm_mixed.o"
"robotarm\stm32h7xx_hal_cortex.o"
"robotarm\stm32h7xx_hal_rcc.o"
"robotarm\stm32h7xx_hal_rcc_ex.o"
"robotarm\stm32h7xx_hal_flash.o"
"robotarm\stm32h7xx_hal_flash_ex.o"
"robotarm\stm32h7xx_hal_gpio.o"
"robotarm\stm32h7xx_hal_hsem.o"
"robotarm\stm32h7xx_hal_dma.o"
"robotarm\stm32h7xx_hal_dma_ex.o"
"robotarm\stm32h7xx_hal_mdma.o"
"robotarm\stm32h7xx_hal_pwr.o"
"robotarm\stm32h7xx_hal_pwr_ex.o"
"robotarm\stm32h7xx_hal.o"
"robotarm\stm32h7xx_hal_i2c.o"
"robotarm\stm32h7xx_hal_i2c_ex.o"
"robotarm\stm32h7xx_hal_exti.o"
